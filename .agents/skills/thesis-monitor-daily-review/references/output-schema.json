{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thesis Monitor AI Daily Review Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "claim_id", "analysis_policy_version", "knowledge_version", "knowledge_sha256", "market", "assessment_date", "market_review", "stock_reviews"],
  "properties": {
    "schema_version": {"const": "2"},
    "packet_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "analysis_policy_version": {"type": "string", "minLength": 1},
    "knowledge_version": {"type": "string", "minLength": 1},
    "knowledge_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "market": {"enum": ["us", "kr"]},
    "assessment_date": {"type": "string", "format": "date"},
    "market_review": {"$ref": "#/$defs/marketReview"},
    "stock_reviews": {"type": "array", "items": {"$ref": "#/$defs/stockReview"}}
  },
  "$defs": {
    "textList": {"type": "array", "items": {"type": "string"}},
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "fact_ids"],
      "properties": {"text": {"type": "string"}, "fact_ids": {"$ref": "#/$defs/textList"}}
    },
    "numericClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "field_path", "value", "unit", "semantic_type", "text_ref", "usage"],
      "properties": {
        "fact_id": {"type": "string"}, "field_path": {"type": "string"},
        "value": {"type": "number"}, "unit": {"type": "string"},
        "semantic_type": {"type": "string", "minLength": 1},
        "text_ref": {
          "type": "string",
          "pattern": "^(summary|holder_view|new_buyer_view|interpretation\\[[0-9]+\\]\\.text|unknowns\\[[0-9]+\\]|next_checks\\[[0-9]+\\])$"
        },
        "usage": {"type": "string", "minLength": 1}
      }
    },
    "marketReview": {
      "type": "object", "additionalProperties": false,
      "required": ["facts_used", "frameworks_used", "interpretation", "numeric_claims", "unknowns", "summary"],
      "properties": {
        "facts_used": {"$ref": "#/$defs/textList"}, "frameworks_used": {"$ref": "#/$defs/textList"},
        "interpretation": {"type": "array", "items": {"$ref": "#/$defs/interpretation"}},
        "numeric_claims": {"type": "array", "items": {"$ref": "#/$defs/numericClaim"}},
        "unknowns": {"$ref": "#/$defs/textList"}, "summary": {"type": "string"}
      }
    },
    "stockReview": {
      "type": "object", "additionalProperties": false,
      "required": ["ticker", "thesis_version", "ai_thesis_assessment", "earnings_estimate_view", "valuation_view", "facts_used", "frameworks_used", "interpretation", "numeric_claims", "unknowns", "summary", "holder_view", "new_buyer_view", "next_checks", "confidence"],
      "properties": {
        "ticker": {"type": "string"}, "thesis_version": {"type": "integer", "minimum": 1},
        "ai_thesis_assessment": {"enum": ["strengthened", "weakened", "mixed", "no_material_change", "needs_review", "invalidation_candidate", "invalidated"]},
        "earnings_estimate_view": {"enum": ["up", "down", "mixed", "unchanged", "unknown"]},
        "valuation_view": {"enum": ["expansion", "compression", "mixed", "neutral", "unknown"]},
        "facts_used": {"$ref": "#/$defs/textList"}, "frameworks_used": {"$ref": "#/$defs/textList"},
        "interpretation": {"type": "array", "items": {"$ref": "#/$defs/interpretation"}},
        "numeric_claims": {"type": "array", "items": {"$ref": "#/$defs/numericClaim"}},
        "unknowns": {"$ref": "#/$defs/textList"}, "summary": {"type": "string"},
        "holder_view": {"type": "string"}, "new_buyer_view": {"type": "string"},
        "next_checks": {"$ref": "#/$defs/textList"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
