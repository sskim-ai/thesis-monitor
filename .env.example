DATA_DIR=./data
DATABASE_URL=sqlite:///./data/thesis_monitor.sqlite3
APP_ENV=local
ENABLE_LIVE_PROVIDERS=false
INCLUDE_MOCK_PROVIDER=true
LIVE_PROVIDER_TIMEOUT_SECONDS=5
NAVER_NEWS_DISPLAY=10
GOOGLE_NEWS_DISPLAY=10

# Optional future data providers. Keep real keys only in .env.
OPENDART_API_KEY=
NEWSAPI_API_KEY=
ENABLE_NEWSAPI_PROVIDER=false
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
KRX_OPEN_API_KEY=
KRX_OPEN_API_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_CACHE_DIR=./data/cache/massive
MASSIVE_REQUESTS_PER_MINUTE=5
KIWOOM_GATEWAY_URL=
KIWOOM_GATEWAY_API_KEY=
KIWOOM_GATEWAY_TIMEOUT_SECONDS=15
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_REST_BASE_URL=https://api.kiwoom.com
KIWOOM_REST_TIMEOUT_SECONDS=30
KIWOOM_REST_REQUEST_INTERVAL_SECONDS=0.2
KIWOOM_REST_MAX_RETRIES=3
KIWOOM_REST_MAX_PAGES=50
KIWOOM_KR_MARKET_CONTEXT_ENABLED=false
ALPHA_VANTAGE_CACHE_HOURS=24
ALPHA_VANTAGE_REQUEST_BUDGET=30
OPENFIGI_API_KEY=
FMP_API_KEY=
SHARADAR_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
ECOS_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_NARRATIVE_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=60
SEC_USER_AGENT=
ACTION_API_KEY=

# Local OHLCV Analyst integration. OHLCV_API_KEY falls back to ACTION_API_KEY when omitted.
OHLCV_BASE_URL=http://127.0.0.1:8765
OHLCV_API_KEY=
OHLCV_TIMEOUT_SECONDS=30

# Daily thesis monitoring.
MONITOR_LOOKBACK_DAYS=3
MONITOR_RETRY_ATTEMPTS=3
MONITOR_RETRY_BASE_SECONDS=2
ASSESSMENT_DISTRIBUTION_WARNING_THRESHOLD=0.7
VALUATION_DISTRIBUTION_WARNING_THRESHOLD=0.7
VALUATION_SNAPSHOT_MAX_AGE_DAYS=7
VALUATION_PROVIDER_TIMEOUT_SECONDS=15
CAPITAL_ACTION_REVIEW_SHARE_PCT=0.5
CAPITAL_ACTION_MATERIAL_SHARE_PCT=2.0
CAPITAL_ACTION_REVIEW_MARKET_CAP_PCT=0.5
CAPITAL_ACTION_MATERIAL_MARKET_CAP_PCT=2.0
MACRO_VIX_MATERIAL_PCT=5
MACRO_REAL_YIELD_MATERIAL_BP=5
MACRO_NOMINAL_YIELD_MATERIAL_BP=7
MACRO_CREDIT_SPREAD_MATERIAL_BP=10
MACRO_OTHER_MATERIAL_PCT=1
FINANCIAL_OPERATING_MARGIN_UPPER_BOUND=60

# Macro monitoring. Minute-level event alerts stay disabled until a realtime provider is added.
MACRO_MONITOR_ENABLED=true
MACRO_PROVIDER_TIMEOUT_SECONDS=20
MACRO_BRIEFING_SEND_NO_CHANGE=true
MACRO_ALERT_MIN_MAGNITUDE=3

# Telegram notification delivery. Keep dry-run enabled until credentials are tested.
NOTIFICATION_DRY_RUN=true
NOTIFICATION_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_MAX_CHARS=3500
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_BASE_SECONDS=2

# Codex Scheduled Daily Review. Shadow never changes official assessments or Telegram.
AI_REVIEW_MODE=shadow
AI_REVIEW_PILOT_ENABLED=false
CASH_FLOW_USER_VISIBLE_MODE=OFF
WORKING_CAPITAL_USER_VISIBLE_MODE=OFF
AI_REVIEW_PILOT_TARGET_SUCCESS_DAYS=5
AI_REVIEW_PILOT_US_FALLBACK_TIME=08:40
AI_REVIEW_PILOT_KR_FALLBACK_TIME=17:10
FREE_ANALYST_ADAPTIVE_ENABLED=false
FREE_ANALYST_ADAPTIVE_MODE=current
FREE_ANALYST_ADAPTIVE_CANARY_MAX_MARKET=1
FREE_ANALYST_ADAPTIVE_CANARY_MAX_STOCK=2
FREE_ANALYST_ADAPTIVE_CANARY_MAX_TOTAL=3
AI_REVIEW_CLAIM_LEASE_MINUTES=30
AI_REVIEW_BACKUP_DELAY_MINUTES=40
AI_REVIEW_CLAIM_SAFETY_MARGIN_MINUTES=5
AI_REVIEW_SHADOW_CATCHUP_HOURS=24
