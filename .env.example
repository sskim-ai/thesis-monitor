DATABASE_URL=sqlite:///./thesis_monitor.sqlite3
APP_ENV=local
ENABLE_LIVE_PROVIDERS=false
INCLUDE_MOCK_PROVIDER=true
LIVE_PROVIDER_TIMEOUT_SECONDS=5
NAVER_NEWS_DISPLAY=10
GOOGLE_NEWS_DISPLAY=10

# Optional future data providers. Keep real keys only in .env.
OPENDART_API_KEY=
NEWSAPI_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
SEC_USER_AGENT=
ACTION_API_KEY=
