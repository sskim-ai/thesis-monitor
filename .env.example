DATA_DIR=./data
DATABASE_URL=sqlite:///./data/thesis_monitor.sqlite3
APP_ENV=local
ENABLE_LIVE_PROVIDERS=false
INCLUDE_MOCK_PROVIDER=true
LIVE_PROVIDER_TIMEOUT_SECONDS=5
NAVER_NEWS_DISPLAY=10
GOOGLE_NEWS_DISPLAY=10

# Optional future data providers. Keep real keys only in .env.
OPENDART_API_KEY=
NEWSAPI_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
SEC_USER_AGENT=
ACTION_API_KEY=

# Local OHLCV Analyst integration. OHLCV_API_KEY falls back to ACTION_API_KEY when omitted.
OHLCV_BASE_URL=http://127.0.0.1:8765
OHLCV_API_KEY=
OHLCV_TIMEOUT_SECONDS=30

# Daily thesis monitoring.
MONITOR_LOOKBACK_DAYS=3
MONITOR_RETRY_ATTEMPTS=3
MONITOR_RETRY_BASE_SECONDS=2

# Kakao self-message delivery. Keep dry-run enabled until OAuth setup is complete.
NOTIFICATION_DRY_RUN=true
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REFRESH_TOKEN=
KAKAO_WEB_URL=https://sskim-macmini.tailb44bb1.ts.net/thesis/health
