DATA_DIR=./data
DATABASE_URL=sqlite:///./data/thesis_monitor.sqlite3
APP_ENV=local
ENABLE_LIVE_PROVIDERS=false
INCLUDE_MOCK_PROVIDER=true
LIVE_PROVIDER_TIMEOUT_SECONDS=5
NAVER_NEWS_DISPLAY=10
GOOGLE_NEWS_DISPLAY=10

# Optional future data providers. Keep real keys only in .env.
OPENDART_API_KEY=
NEWSAPI_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
ECOS_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_NARRATIVE_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=60
SEC_USER_AGENT=
ACTION_API_KEY=

# Local OHLCV Analyst integration. OHLCV_API_KEY falls back to ACTION_API_KEY when omitted.
OHLCV_BASE_URL=http://127.0.0.1:8765
OHLCV_API_KEY=
OHLCV_TIMEOUT_SECONDS=30

# Daily thesis monitoring.
MONITOR_LOOKBACK_DAYS=3
MONITOR_RETRY_ATTEMPTS=3
MONITOR_RETRY_BASE_SECONDS=2

# Macro monitoring. Minute-level event alerts stay disabled until a realtime provider is added.
MACRO_MONITOR_ENABLED=true
MACRO_PROVIDER_TIMEOUT_SECONDS=20
MACRO_BRIEFING_SEND_NO_CHANGE=true
MACRO_ALERT_MIN_MAGNITUDE=3

# Notification delivery. Keep dry-run enabled until the selected channel is tested.
NOTIFICATION_DRY_RUN=true
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REFRESH_TOKEN=
KAKAO_TEMPLATE_ID=
KAKAO_WEB_URL=https://sskim-macmini.tailb44bb1.ts.net/thesis/health
NOTIFICATION_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
