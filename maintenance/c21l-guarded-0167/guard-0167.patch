+pub(crate) fn response_receipt(sha: Option<String>, result: &Result<reqwest::Response, reqwest::Error>) {
+    let Some(sha) = sha else { return; };
+    let receipt = match result {
+        Ok(response) => json!({"wire_sha256":sha,"response_status":response.status().as_u16(),
+            "request_id_sha256":response.headers().get("x-request-id").map(|v| digest(v.as_bytes())),
+            "response_headers_received":true,"stream_completion_not_proven":true}),
+        Err(error) => json!({"wire_sha256":sha,"response_headers_received":false,
+            "connect_error":error.is_connect(),"timeout":error.is_timeout(),
+            "cause":safe_error_chain(error)}),
+    };
+    let written = (|| -> Checked<()> {
+        let p = policy()?;
+        let path = p.ledger.with_file_name(format!("response-{sha}.json"));
+        let mut file = OpenOptions::new().write(true).create_new(true).mode(0o600)
+            .custom_flags(0x100).open(path).map_err(|_| "RESPONSE_RECEIPT_OPEN")?;
+        file.write_all(&serde_json::to_vec(&receipt).map_err(|_| "RESPONSE_RECEIPT_JSON")?)
+            .map_err(|_| "RESPONSE_RECEIPT_WRITE")?;
+        file.sync_all().map_err(|_| "RESPONSE_RECEIPT_SYNC")
+    })();
+    if written.is_err() { eprintln!("TM_P1_RESPONSE_RECEIPT_DENIED"); std::process::exit(78); }
+}
