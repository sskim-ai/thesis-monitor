+/// Only typed errno/kind and bounded cause codes leave the trusted host.
+/// Display text is inspected transiently, never emitted or hashed into receipts.
+pub fn safe_error_chain(error: &(dyn std::error::Error + 'static)) -> serde_json::Value {
+    let mut cursor = Some(error);
+    let mut io = Vec::new();
+    let mut depth = 0;
+    let (mut dns, mut proxy, mut tls, mut timeout) = (false, false, false, false);
+    while let Some(cause) = cursor {
+        if depth >= 16 { break; }
+        let text = cause.to_string().to_ascii_lowercase();
+        dns |= text.contains("dns error") || text.contains("failed to lookup address") || text.contains("nodename nor servname");
+        proxy |= text.contains("proxy connect") || text.contains("proxy tunnel");
+        tls |= cause.is::<native_tls::Error>() || cause.is::<rustls::Error>();
+        if let Some(e) = cause.downcast_ref::<std::io::Error>() {
+            timeout |= e.kind() == std::io::ErrorKind::TimedOut;
+            io.push(json!({"kind":format!("{:?}", e.kind()),"os_errno":e.raw_os_error()}));
+        }
+        if let Some(e) = cause.downcast_ref::<reqwest::Error>() { timeout |= e.is_timeout(); }
+        depth += 1;
+        cursor = cause.source();
+    }
+    let code = if dns { "DNS_RESOLUTION_FAILURE" } else if proxy { "PROXY_ROUTE_FAILED" }
+        else if tls { "TLS_TRUST_OR_NEGOTIATION" } else if timeout { "TIMEOUT" }
+        else if io.iter().any(|v| v["kind"] == "PermissionDenied") { "IO_PERMISSION_DENIED_LAYER_UNCONFIRMED" }
+        else if io.iter().any(|v| v["kind"] == "ConnectionRefused") { "TCP_CONNECTION_REFUSED" }
+        else { "UNKNOWN" };
+    json!({"schema":"REDACTED_CONNECT_CAUSE_V1","code":code,"io":io,"depth":depth,
+        "truncated":cursor.is_some(),"dns_proxy_text_match_is_diagnostic_not_authority":true})
+}
