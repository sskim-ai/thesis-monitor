+//! Task-local, fail-closed dispatch boundary. Not an upstream/product policy.
+use serde::Deserialize;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::fs::{self, OpenOptions};
+use std::io::{Read, Seek, Write};
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+use std::path::PathBuf;
+use std::sync::OnceLock;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+type Checked<T> = Result<T, &'static str>;
+const MAX_BODY: usize = 384 * 1024;
+const MAX_REQUESTS: usize = 12;
+#[path = "sol_task_scope.rs"]
+mod sol_task_scope;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Policy {
+    #[serde(default)]
+    execution_profile: Option<String>,
+    #[serde(default)]
+    account: Option<String>,
+    task: String,
+    stage: String,
+    security: String,
+    owner_sha256: String,
+    prompt_sha256: String,
+    request_sha256: String,
+    thread_id: String,
+    source_generation: String,
+    schema: Value,
+    #[serde(default)]
+    schema_binding: Option<SchemaBinding>,
+    started_unix: u64,
+    deadline_unix: u64,
+    ledger: PathBuf,
+}
+
+#[derive(Deserialize, serde::Serialize)]
+#[serde(deny_unknown_fields)]
+struct SchemaBinding {
+    adapter_version: String,
+    canonical_schema_sha256: String,
+    wire_schema_sha256: String,
+    changed_paths: Vec<String>,
+}
+
+pub fn http_only() -> bool { true }
+
+fn digest(bytes: &[u8]) -> String { format!("{:x}", Sha256::digest(bytes)) }
+
+fn now() -> Checked<u64> {
+    SystemTime::now().duration_since(UNIX_EPOCH).map(|v| v.as_secs()).map_err(|_| "CLOCK")
+}
+
+fn policy() -> Checked<&'static Policy> {
+    static POLICY: OnceLock<Result<Policy, &'static str>> = OnceLock::new();
+    POLICY.get_or_init(|| {
+        let path = std::env::var_os("TM_P1_DISPATCH_POLICY").ok_or("POLICY_MISSING")?;
+        let expected = match std::env::var("TM_P1_DISPATCH_POLICY_SHA256") {
+            Ok(value) => value,
+            Err(_) => {
+                // The stdio client learns the thread ID before publishing this immutable pin.
+                let pin = std::env::var_os("TM_P1_DISPATCH_POLICY_PIN_FILE").ok_or("POLICY_PIN_MISSING")?;
+                let meta = fs::symlink_metadata(&pin).map_err(|_| "POLICY_PIN_STAT")?;
+                if !meta.is_file() || meta.nlink() != 1 || meta.len() != 64 { return Err("POLICY_PIN_IDENTITY"); }
+                fs::read_to_string(pin).map_err(|_| "POLICY_PIN_READ")?
+            }
+        };
+        let metadata = fs::symlink_metadata(&path).map_err(|_| "POLICY_STAT")?;
+        if !metadata.is_file() || metadata.nlink() != 1 || metadata.len() > 128*1024 {
+            return Err("POLICY_NOT_PLAIN_BOUNDED_FILE");
+        }
+        let bytes = fs::read(path).map_err(|_| "POLICY_READ")?;
+        if digest(&bytes) != expected { return Err("POLICY_DIGEST"); }
+        let policy: Policy = serde_json::from_slice(&bytes).map_err(|_| "POLICY_FORMAT")?;
+        validate_schema_binding(&policy.schema, policy.schema_binding.as_ref())?;
+        let sol_scope = sol_task_scope::validate_policy(&policy)?;
+        if !sol_scope || !["BLIND", "ADJ"].contains(&policy.stage.as_str())
+            || policy.security.is_empty() || policy.owner_sha256.len() != 64
+            || policy.prompt_sha256.len() != 64 || policy.request_sha256.len() != 64
+            || policy.thread_id.is_empty() || policy.source_generation.is_empty()
+            || policy.deadline_unix <= policy.started_unix
+            || policy.deadline_unix - policy.started_unix > 600 || !policy.ledger.is_absolute() {
+            return Err("POLICY_SCOPE");
+        }
+        Ok(policy)
+    }).as_ref().map_err(|e| *e)
+}
+
+fn network_task_scope(task: &str, ledger: &std::path::Path) -> bool {
+    task == "POSCO_P1_FLEXIBLE_OUTPUT_20261101"
+        && ledger.starts_with("/private/tmp/tm-posco-p1-flexible-output-20261101")
+        && !ledger.components().any(|c| c == std::path::Component::ParentDir)
+}
+
+fn validate_schema_binding(schema: &Value, binding: Option<&SchemaBinding>) -> Checked<()> {
+    let b=binding.ok_or("SCHEMA_BINDING_MISSING")?;
+    let valid_sha=|s: &str| s.len()==64 && s.bytes().all(|c| c.is_ascii_hexdigit());
+    if b.adapter_version!="LOCAL_REF_DESCRIPTION_INLINE_V1" || !valid_sha(&b.canonical_schema_sha256)
+        || !valid_sha(&b.wire_schema_sha256) || b.changed_paths.is_empty()
+        || b.changed_paths.iter().any(|p| !p.starts_with('/')) {
+        return Err("SCHEMA_BINDING_SCOPE");
+    }
+    if digest(&serde_json::to_vec(schema).map_err(|_| "SCHEMA_HASH")?)!=b.wire_schema_sha256 {
+        return Err("WIRE_SCHEMA_DIGEST");
+    }
+    Ok(())
+}
+
+fn validate_wire_format(body: &Value) -> Checked<()> {
+    if body.pointer("/text/format/type").and_then(Value::as_str)!=Some("json_schema")
+        || body.pointer("/text/format/strict")!=Some(&Value::Bool(true)) {
+        return Err("STRICT_FORMAT_REQUIRED");
+    }
+    Ok(())
+}
+
+// Catalog equality covers full schemas, namespaces, descriptions and nested V8 declarations.
+// No recursive fallback: tool declarations in unrecognized locations are rejected.
+fn catalog_locations(value: &Value, path: &str, found: &mut Vec<Value>) -> Checked<()> {
+    match value {
+        Value::Object(map) => {
+            for (key, child) in map {
+                if key == "tools" {
+                    let permitted = path.is_empty() || (path.starts_with("/input/")
+                        && path[7..].parse::<usize>().is_ok()
+                        && map.get("type").and_then(Value::as_str) == Some("additional_tools")
+                        && map.get("role").and_then(Value::as_str) == Some("developer"));
+                    if !permitted { return Err("NESTED_TOOL_LOCATION"); }
+                    if child.is_null() { continue; }
+                    if !child.is_array() { return Err("TOOLS_NOT_ARRAY"); }
+                    if child.as_array().is_some_and(|v| v.is_empty()) { continue; }
+                    found.push(child.clone());
+                } else {
+                    if key == "additional_tools" { return Err("UNRECOGNIZED_ADDITIONAL_TOOLS"); }
+                    catalog_locations(child, &format!("{path}/{key}"), found)?;
+                }
+            }
+        }
+        Value::Array(items) => {
+            for (index, item) in items.iter().enumerate() {
+                catalog_locations(item, &format!("{path}/{index}"), found)?;
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+fn inspect(bytes: &[u8], schema: &Value, allowed_catalog: &Value) -> Checked<Value> {
+    inspect_profile(bytes, schema, allowed_catalog, "gpt-6-astra", "xhigh")
+}
+
+fn inspect_profile(bytes: &[u8], schema: &Value, allowed_catalog: &Value, model: &str, effort: &str) -> Checked<Value> {
+    if bytes.len() > MAX_BODY { return Err("WIRE_INPUT_LIMIT"); }
+    let body: Value = serde_json::from_slice(bytes).map_err(|_| "BODY_JSON")?;
+    if body.get("model").and_then(Value::as_str) != Some(model)
+        || body.pointer("/reasoning/effort").and_then(Value::as_str) != Some(effort) {
+        return Err("MODEL_EFFORT");
+    }
+    if body.pointer("/text/format/schema") != Some(schema) { return Err("OUTPUT_SCHEMA"); }
+    if body.get("stream") != Some(&Value::Bool(true)) { return Err("NON_STREAM_REQUEST"); }
+    if body.get("generate") == Some(&Value::Bool(false)) || body.get("previous_response_id").is_some() {
+        return Err("PREWARM_OR_UNBOUND_CONTINUATION");
+    }
+    let mut catalogs = Vec::new();
+    catalog_locations(&body, "", &mut catalogs)?;
+    if catalogs.len() != 1 || &catalogs[0] != allowed_catalog {
+        // Offline-only diagnostic contains generated tool declarations, never prompt/auth/body.
+        if std::env::var("TM_P1_PREDISPATCH_PROBE").as_deref()==Ok("1") {
+            let p=policy()?;
+            let bytes=serde_json::to_vec(&catalogs).map_err(|_| "CATALOG_DIAGNOSTIC_JSON")?;
+            if bytes.len()>64*1024 { return Err("CATALOG_DIAGNOSTIC_LIMIT"); }
+            let mut f=OpenOptions::new().write(true).create_new(true).mode(0o600).custom_flags(0x100)
+                .open(p.ledger.with_file_name("observed-public-tool-catalog.json")).map_err(|_| "CATALOG_DIAGNOSTIC_WRITE")?;
+            f.write_all(&bytes).map_err(|_| "CATALOG_DIAGNOSTIC_WRITE")?;
+            f.sync_all().map_err(|_| "CATALOG_DIAGNOSTIC_SYNC")?;
+            eprintln!("TM_P1_PUBLIC_CATALOG_DIAGNOSTIC:sha256={};bytes={}",digest(&bytes),bytes.len());
+        }
+        return Err("CATALOG_MISMATCH");
+    }
+    Ok(body)
+}
+
+fn reserve(bytes: &[u8], body: &Value, p: &Policy, timestamp: u64) -> Checked<()> {
+    // macOS O_NOFOLLOW. This binary is task-local to the approved Mac host.
+    let mut file = OpenOptions::new().read(true).write(true).create(true)
+        .truncate(false).mode(0o600).custom_flags(0x100)
+        .open(&p.ledger).map_err(|_| "LEDGER_OPEN")?;
+    file.try_lock().map_err(|_| "LEDGER_CONCURRENT")?;
+    let metadata = file.metadata().map_err(|_| "LEDGER_STAT")?;
+    if !metadata.is_file() || metadata.nlink() != 1 || metadata.len() > 64*1024 { return Err("LEDGER_IDENTITY"); }
+    let mut existing = String::new();
+    file.read_to_string(&mut existing).map_err(|_| "LEDGER_READ")?;
+    let mut records: Vec<Value> = if existing.is_empty() { vec![] } else {
+        serde_json::from_str(&existing).map_err(|_| "LEDGER_FORMAT")?
+    };
+    sol_task_scope::validate_records(&records, p)?;
+    let sha = digest(bytes);
+    let input_sha = digest(&serde_json::to_vec(&body["input"]).map_err(|_| "INPUT_HASH")?);
+    if records.len() >= MAX_REQUESTS { return Err("INFERENCE_BUDGET"); }
+    if records.iter().any(|r| r["wire_sha256"] == sha || r["input_sha256"] == input_sha) { return Err("RETRY_FORBIDDEN"); }
+    if records.iter().any(|r| r["task"] != p.task || r["security"] != p.security) {
+        return Err("LEDGER_TASK_BINDING");
+    }
+    if records.iter().any(|r| r["stage"] == "ADJ") && p.stage != "ADJ" {
+        return Err("STAGE_REPLAY_FORBIDDEN");
+    }
+    if records.iter().any(|r| r["stage"] == p.stage && (r["thread_id"] != p.thread_id || r["request_sha256"] != p.request_sha256)) {
+        return Err("STAGE_BINDING");
+    }
+    records.push(json!({"task":p.task,"stage":p.stage,"security":p.security,
+        "execution_profile":p.execution_profile,"account":p.account,
+        "owner_sha256":p.owner_sha256,"prompt_sha256":p.prompt_sha256,
+        "request_sha256":p.request_sha256,"thread_id":p.thread_id,
+        "source_generation":p.source_generation,"input_sha256":input_sha,
+        "wire_sha256":sha,"wire_bytes":bytes.len(),"parsed_sha256":digest(&serde_json::to_vec(body).map_err(|_| "PARSED_HASH")?),
+        "catalog_sha256":digest(include_bytes!("task_guard_catalog.json")),
+        "schema_binding":p.schema_binding,
+        "observed_output_schema_sha256":digest(&serde_json::to_vec(&body["text"]["format"]["schema"]).map_err(|_| "SCHEMA_HASH")?),
+        "model":body["model"],"effort":body["reasoning"]["effort"],"dispatch_number":records.len()+1,
+        "time":timestamp,"status":"RESERVED_BEFORE_TRANSPORT_NOT_RESPONSE_PROOF"}));
+    let encoded = serde_json::to_vec(&records).map_err(|_| "LEDGER_ENCODE")?;
+    file.rewind().map_err(|_| "LEDGER_SEEK")?;
+    file.write_all(&encoded).map_err(|_| "LEDGER_WRITE")?;
+    file.set_len(encoded.len() as u64).map_err(|_| "LEDGER_LENGTH")?;
+    file.sync_all().map_err(|_| "LEDGER_SYNC")?;
+    Ok(())
+}
+
+fn check(request: &reqwest::Request) -> Checked<()> {
+    let url = request.url();
+    if url.scheme() != "https" || url.port_or_known_default() != Some(443)
+        || !url.username().is_empty() || url.password().is_some() { return Err("TRANSPORT_OR_DESTINATION"); }
+    let host = url.host_str().ok_or("DESTINATION_HOST")?;
+    let path = url.path();
+    // Auth remains entirely inside the original host. No body/header is recorded here.
+    if host == "auth.openai.com" && path == "/oauth/token" && request.method() == reqwest::Method::POST {
+        return Ok(());
+    }
+    if host != "chatgpt.com" { return Err("DESTINATION_HOST"); }
+    if path == "/backend-api/wham/settings/user" {
+        control_shape(request)?;
+        return reserve_control(policy()?, now()?);
+    }
+    if request.method() == reqwest::Method::GET && path == "/backend-api/codex/models" { return Ok(()); }
+    if request.method() != reqwest::Method::POST || path != "/backend-api/codex/responses" || url.query().is_some() {
+        return Err("NON_RESPONSES_ROUTE");
+    }
+    if !request.headers().contains_key("authorization") { return Err("HOST_AUTH_MISSING"); }
+    if request.headers().contains_key("content-encoding") { return Err("COMPRESSED_PAYLOAD_UNSUPPORTED"); }
+    let bytes = request.body().and_then(reqwest::Body::as_bytes).ok_or("NON_REPLAYABLE_BODY")?;
+    let p = policy()?;
+    if request.headers().get("chatgpt-account-id").and_then(|v| v.to_str().ok()) != p.account.as_deref() {
+        return Err("ACCOUNT_HEADER_BINDING");
+    }
+    if request.headers().get("thread-id").and_then(|v| v.to_str().ok()) != Some(p.thread_id.as_str()) {
+        return Err("THREAD_BINDING");
+    }
+    let timestamp = now()?;
+    if timestamp < p.started_unix || timestamp >= p.deadline_unix { return Err("STAGE_DEADLINE"); }
+    let catalog: Value = serde_json::from_str(include_str!("task_guard_catalog.json")).map_err(|_| "COMPILED_CATALOG")?;
+    let body = if p.execution_profile.as_deref() == Some(sol_task_scope::PROFILE) {
+        inspect_profile(bytes, &p.schema, &catalog, "gpt-6.1-sol", "high")?
+    } else {
+        inspect(bytes, &p.schema, &catalog)?
+    };
+    validate_wire_format(&body)?;
+    let prompt_found = body["input"].as_array().is_some_and(|items| items.iter().any(|item| {
+        item["role"] == "user" && item["content"].as_array().is_some_and(|content| content.iter().any(|part| {
+            part["type"] == "input_text" && part["text"].as_str().is_some_and(|text| digest(text.as_bytes()) == p.prompt_sha256)
+        }))
+    }));
+    if !prompt_found { return Err("ORIGINAL_PROMPT_MISSING"); }
+    reserve(bytes, &body, p, timestamp)
+}
+
+fn control_shape(request: &reqwest::Request) -> Checked<()> {
+    if request.method() != reqwest::Method::GET || request.url().query().is_some()
+        || request.body().is_some() || !request.headers().contains_key("authorization")
+        || request.headers().get("cache-control").and_then(|v| v.to_str().ok()) != Some("no-cache, no-store") {
+        return Err("HOST_CONTROL_SHAPE");
+    }
+    Ok(())
+}
+
+fn control_id(p: &Policy) -> String {
+    digest(format!("GIT_ATTRIBUTION_POLICY_V1:{}:{}:{}",p.stage,p.thread_id,p.request_sha256).as_bytes())
+}
+
+fn reserve_control(p: &Policy, timestamp: u64) -> Checked<()> {
+    if timestamp < p.started_unix || timestamp >= p.deadline_unix { return Err("STAGE_DEADLINE"); }
+    if p.ledger.exists() {
+        let rows: Vec<Value> = serde_json::from_slice(&fs::read(&p.ledger).map_err(|_| "CONTROL_PHASE_LEDGER")?)
+            .map_err(|_| "CONTROL_PHASE_LEDGER")?;
+        if rows.iter().any(|r|r["thread_id"]==p.thread_id) { return Err("HOST_CONTROL_AFTER_INFERENCE"); }
+    }
+    let mut file=OpenOptions::new().read(true).write(true).create(true).truncate(false).mode(0o600)
+        .custom_flags(0x100).open(p.ledger.with_file_name("host-control-ledger.json")).map_err(|_| "CONTROL_LEDGER_OPEN")?;
+    file.try_lock().map_err(|_| "CONTROL_LEDGER_CONCURRENT")?;
+    let meta=file.metadata().map_err(|_| "CONTROL_LEDGER_STAT")?;
+    if !meta.is_file() || meta.nlink()!=1 || meta.len()>8192 { return Err("CONTROL_LEDGER_IDENTITY"); }
+    let mut raw=String::new();file.read_to_string(&mut raw).map_err(|_| "CONTROL_LEDGER_READ")?;
+    let mut rows:Vec<Value>=if raw.is_empty(){vec![]}else{serde_json::from_str(&raw).map_err(|_| "CONTROL_LEDGER_FORMAT")?};
+    if rows.len()>=2 || rows.iter().any(|r|r["stage"]==p.stage || r["thread_id"]==p.thread_id) {
+        return Err("HOST_CONTROL_NO_RETRY_BUDGET");
+    }
+    rows.push(json!({"policy":"GIT_ATTRIBUTION_POLICY_V1","route":"GET /backend-api/wham/settings/user",
+        "stage":p.stage,"thread_id":p.thread_id,"request_sha256":p.request_sha256,"dispatch_id":control_id(p),
+        "phase":"PRE_INFERENCE_WORLD_STATE","timestamp":timestamp,"body_present":false,"inference":false}));
+    let bytes=serde_json::to_vec(&rows).map_err(|_| "CONTROL_LEDGER_JSON")?;
+    file.rewind().map_err(|_| "CONTROL_LEDGER_SEEK")?;file.write_all(&bytes).map_err(|_| "CONTROL_LEDGER_WRITE")?;
+    file.set_len(bytes.len() as u64).map_err(|_| "CONTROL_LEDGER_SIZE")?;file.sync_all().map_err(|_| "CONTROL_LEDGER_SYNC")
+}
+
+pub(crate) fn enforce(request: &reqwest::Request) -> Option<String> {
+    if std::env::var("TM_P1_PREDISPATCH_PROBE").as_deref() == Ok("1")
+        && request.url().path() != "/backend-api/codex/responses" {
+        eprintln!("TM_P1_PREDISPATCH_DENIED:OFFLINE_ANCILLARY_FORBIDDEN");
+        std::process::exit(78);
+    }
+    if let Err(reason) = check(request) {
+        // Only compiled public route names and Rust symbols; never URL/query/header/body values.
+        eprintln!("TM_P1_ROUTE_DENIAL:{}", denial_metadata(request, reason));
+        eprintln!("TM_P1_PREDISPATCH_DENIED:{reason}");
+        std::process::exit(78);
+    }
+    if request.url().path() == "/backend-api/codex/responses" {
+        if std::env::var("TM_P1_PREDISPATCH_PROBE").as_deref() == Ok("1") {
+            eprintln!("TM_P1_OFFLINE_PREDISPATCH_PASS:catalog_model_effort_schema_prompt_thread_budget_checked;transport_called=false");
+            std::process::exit(77);
+        }
+        Some(digest(request.body().and_then(reqwest::Body::as_bytes).unwrap_or_default()))
+    } else if request.url().path()=="/backend-api/wham/settings/user" {
+        Some(format!("control-{}",control_id(policy().expect("checked policy"))))
+    } else {
+        eprintln!("TM_P1_EXISTING_ANCILLARY_ALLOWED:{}",if request.url().host_str()==Some("auth.openai.com"){"ORIGINAL_AUTH"}else{"MODEL_METADATA"});
+        None
+    }
+}
+
+fn denial_metadata(request: &reqwest::Request, reason: &str) -> Value {
+    let host_class = match request.url().host_str() {
+        Some("chatgpt.com") => "CHATGPT",
+        Some("auth.openai.com") => "ORIGINAL_AUTH",
+        _ => "OTHER_REDACTED",
+    };
+    let path = request.url().path();
+    let template = match path {
+        "/backend-api/wham/usage" | "/backend-api/wham/settings/user"
+        | "/backend-api/wham/accounts/check" | "/backend-api/wham/profiles/me"
+        | "/backend-api/wham/rate-limit-reset-credits" | "/backend-api/wham/workspace-messages"
+        | "/backend-api/codex/models" | "/backend-api/codex/responses"
+        | "/backend-api/codex/analytics-events/events"
+        | "/backend-api/codex/responses/compact" | "/oauth/token" => path,
+        _ => "/<redacted>",
+    };
+    let trace = std::backtrace::Backtrace::force_capture().to_string();
+    let symbols: Vec<String> = trace.lines().filter_map(|line| {
+        let (_, value) = line.trim().split_once(": ")?;
+        if value.starts_with("codex_") && value.len() < 320
+            && value.chars().all(|c| c.is_ascii_alphanumeric() || "_:<> {},.&()".contains(c)) {
+            Some(value.to_owned())
+        } else { None }
+    }).take(16).collect();
