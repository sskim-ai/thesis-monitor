{
  "openapi": "3.1.0",
  "info": {
    "title": "Thesis Monitor Public Action API",
    "version": "0.2.0",
    "description": "Collect thesis evidence, register versioned investment theses, manage the monitored stock list, and read daily thesis assessments. Administrative jobs are excluded."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Get Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Gethealth"
                }
              }
            }
          }
        }
      }
    },
    "/provider-status": {
      "get": {
        "summary": "Get Provider Status",
        "operationId": "getProviderStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderStatusResponse"
                  },
                  "type": "array",
                  "title": "Response Getproviderstatus"
                }
              }
            }
          }
        }
      }
    },
    "/monitoring-items": {
      "post": {
        "tags": [
          "monitoring"
        ],
        "summary": "Start or update thesis monitoring for a stock",
        "description": "Use when the user says a stock should be monitored going forward. First collect current company evidence and construct a concrete thesis. Changed thesis fields create a new version; an identical request is idempotent.",
        "operationId": "monitorStock",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MonitoringItemCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitoringItemRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "monitoring"
        ],
        "summary": "List monitored stocks and their current theses",
        "operationId": "listMonitoredStocks",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "active_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Active Only"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MonitoringItemRead"
                  },
                  "title": "Response Listmonitoredstocks"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/monitoring-items/{ticker}": {
      "get": {
        "tags": [
          "monitoring"
        ],
        "summary": "Monitored Stock",
        "operationId": "getMonitoredStock",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticker"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitoringItemRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/monitoring-items/{ticker}/deactivate": {
      "post": {
        "tags": [
          "monitoring"
        ],
        "summary": "Stop monitoring a stock without deleting its history",
        "operationId": "stopMonitoringStock",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticker"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitoringItemRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/monitoring-items/{ticker}/assessments": {
      "get": {
        "tags": [
          "monitoring"
        ],
        "summary": "Assessment History",
        "operationId": "getThesisAssessmentHistory",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticker"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 365,
              "minimum": 1,
              "default": 30,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ThesisAssessmentRead"
                  },
                  "title": "Response Getthesisassessmenthistory"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/thesis-events": {
      "get": {
        "summary": "Get Thesis Events",
        "operationId": "getThesisEvents",
        "parameters": [
          {
            "name": "ticker",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Ticker"
            }
          },
          {
            "name": "lookback_days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 365,
              "minimum": 1,
              "default": 30,
              "title": "Lookback Days"
            }
          },
          {
            "name": "requires_review_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Requires Review Only"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Provider"
            }
          },
          {
            "name": "auto_backfill",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Auto Backfill"
            }
          },
          {
            "name": "backfill_years",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "default": 5,
              "title": "Backfill Years"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThesisEventResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/company-profile": {
      "get": {
        "summary": "Get Company Profile",
        "operationId": "getCompanyProfile",
        "parameters": [
          {
            "name": "ticker",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Ticker"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/earnings-checkpoints": {
      "get": {
        "summary": "Get Earnings Checkpoints",
        "operationId": "getEarningsCheckpoints",
        "parameters": [
          {
            "name": "ticker",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Ticker"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EarningsCheckpointResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssessmentStatus": {
        "type": "string",
        "enum": [
          "strengthened",
          "weakened",
          "mixed",
          "no_material_change",
          "invalidation_candidate",
          "invalidated",
          "needs_review"
        ],
        "title": "AssessmentStatus"
      },
      "BackfillStatus": {
        "properties": {
          "requested": {
            "type": "boolean",
            "title": "Requested",
            "default": false
          },
          "executed": {
            "type": "boolean",
            "title": "Executed",
            "default": false
          },
          "skipped": {
            "type": "boolean",
            "title": "Skipped",
            "default": false
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": "not_requested"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "years": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Years"
          },
          "snapshot_count_before": {
            "type": "integer",
            "title": "Snapshot Count Before",
            "default": 0
          },
          "snapshot_count_after": {
            "type": "integer",
            "title": "Snapshot Count After",
            "default": 0
          },
          "backfilled_count": {
            "type": "integer",
            "title": "Backfilled Count",
            "default": 0
          },
          "report_count": {
            "type": "integer",
            "title": "Report Count",
            "default": 0
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          }
        },
        "type": "object",
        "title": "BackfillStatus"
      },
      "CompanyProfile": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "exchange": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange"
          },
          "industry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Industry"
          },
          "sector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sector"
          },
          "business_units": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Business Units",
            "default": []
          },
          "major_revenue_sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Major Revenue Sources",
            "default": []
          },
          "major_customers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Major Customers",
            "default": []
          },
          "ir_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ir Url"
          },
          "filings_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filings Url"
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "company_name"
        ],
        "title": "CompanyProfile"
      },
      "DailyMonitorResponse": {
        "properties": {
          "run_date": {
            "type": "string",
            "format": "date",
            "title": "Run Date"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "ticker_count": {
            "type": "integer",
            "title": "Ticker Count"
          },
          "success_count": {
            "type": "integer",
            "title": "Success Count"
          },
          "failure_count": {
            "type": "integer",
            "title": "Failure Count"
          },
          "assessments": {
            "items": {
              "$ref": "#/components/schemas/ThesisAssessmentRead"
            },
            "type": "array",
            "title": "Assessments"
          }
        },
        "type": "object",
        "required": [
          "run_date",
          "status",
          "ticker_count",
          "success_count",
          "failure_count"
        ],
        "title": "DailyMonitorResponse"
      },
      "EarningsCheckpointResponse": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "checkpoints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checkpoints"
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "checkpoints"
        ],
        "title": "EarningsCheckpointResponse"
      },
      "EventType": {
        "type": "string",
        "enum": [
          "new_customer",
          "large_order",
          "production_order",
          "mass_production_change",
          "revenue_guidance_up",
          "revenue_guidance_down",
          "margin_improvement",
          "margin_deterioration",
          "fcf_deterioration",
          "inventory_increase",
          "inventory_normalization",
          "receivables_increase",
          "dilution_risk",
          "capital_raise",
          "convertible_bond",
          "warrant",
          "stock_compensation_increase",
          "partnership",
          "partnership_to_revenue",
          "customer_loss",
          "customer_concentration_risk",
          "market_share_change",
          "competitor_price_cut",
          "competitor_new_product",
          "technology_competition",
          "regulatory_risk",
          "export_control",
          "antitrust",
          "accounting_issue",
          "debt_liquidity_risk",
          "credit_rating_change",
          "management_governance",
          "capital_allocation",
          "earnings_surprise",
          "earnings_miss",
          "guidance_change",
          "valuation_recalculation_needed",
          "non_thesis_noise"
        ],
        "title": "EventType"
      },
      "FinancialImpact": {
        "properties": {
          "revenue_guidance_changed": {
            "type": "boolean",
            "title": "Revenue Guidance Changed",
            "default": false
          },
          "margin_guidance_changed": {
            "type": "boolean",
            "title": "Margin Guidance Changed",
            "default": false
          },
          "margin_quality_review": {
            "type": "boolean",
            "title": "Margin Quality Review",
            "default": false
          },
          "financial_statement_basis_warning": {
            "type": "boolean",
            "title": "Financial Statement Basis Warning",
            "default": false
          },
          "fcf_impact_known": {
            "type": "boolean",
            "title": "Fcf Impact Known",
            "default": false
          },
          "dilution_risk": {
            "type": "boolean",
            "title": "Dilution Risk",
            "default": false
          },
          "capex_impact_known": {
            "type": "boolean",
            "title": "Capex Impact Known",
            "default": false
          },
          "inventory_risk": {
            "type": "boolean",
            "title": "Inventory Risk",
            "default": false
          },
          "receivables_risk": {
            "type": "boolean",
            "title": "Receivables Risk",
            "default": false
          }
        },
        "type": "object",
        "title": "FinancialImpact"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvestmentThesisRead": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "core_thesis": {
            "type": "string",
            "title": "Core Thesis"
          },
          "time_horizon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Horizon"
          },
          "strengthen_signals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strengthen Signals"
          },
          "weaken_signals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Weaken Signals"
          },
          "invalidation_signals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Invalidation Signals"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "version",
          "core_thesis",
          "time_horizon",
          "strengthen_signals",
          "weaken_signals",
          "invalidation_signals",
          "status",
          "source",
          "created_at"
        ],
        "title": "InvestmentThesisRead"
      },
      "MonitoringItemCreate": {
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1,
            "title": "Ticker",
            "description": "Ticker, stock code, or supported Korean company name."
          },
          "company_name": {
            "type": "string",
            "minLength": 1,
            "title": "Company Name",
            "description": "Canonical company display name."
          },
          "exchange": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange",
            "description": "Exchange such as KRX or NASDAQ."
          },
          "core_thesis": {
            "type": "string",
            "minLength": 1,
            "title": "Core Thesis",
            "description": "Current one-paragraph investment thesis."
          },
          "time_horizon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Horizon",
            "description": "Expected investment horizon."
          },
          "strengthen_signals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strengthen Signals",
            "description": "Concrete future facts that would strengthen the thesis."
          },
          "weaken_signals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Weaken Signals",
            "description": "Concrete future facts that would weaken the thesis."
          },
          "invalidation_signals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Invalidation Signals",
            "description": "Explicit facts that would invalidate the thesis."
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "company_name",
          "core_thesis"
        ],
        "title": "MonitoringItemCreate"
      },
      "MonitoringItemRead": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "exchange": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          },
          "thesis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InvestmentThesisRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "latest_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AssessmentStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "latest_assessment_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Assessment Date"
          },
          "current_thesis_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Thesis Summary"
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "company_name",
          "exchange",
          "active",
          "thesis"
        ],
        "title": "MonitoringItemRead"
      },
      "PriceContext": {
        "properties": {
