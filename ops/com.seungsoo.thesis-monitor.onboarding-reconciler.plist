<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.seungsoo.thesis-monitor.onboarding-reconciler</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/sskim/Codex/thesis-monitor &amp;&amp; . .venv/bin/activate &amp;&amp; exec python -m app.jobs.reconcile_onboarding --market all --origin background_scheduler</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>WorkingDirectory</key>
    <string>/Users/sskim/Codex/thesis-monitor</string>
    <key>StandardOutPath</key>
    <string>/Users/sskim/Codex/thesis-monitor/logs/onboarding-reconciler.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sskim/Codex/thesis-monitor/logs/onboarding-reconciler.err.log</string>
</dict>
</plist>
